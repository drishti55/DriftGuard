# DriftGuard Environment Configuration
# Copy this file to .env and fill in values

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=codellama:7b
OLLAMA_TIMEOUT=120

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Dataset paths (relative to project root)
DATASET_DIR=driftguard-dataset
REPOS_DIR=driftguard-dataset/repositories
SNAPSHOTS_DIR=driftguard-dataset/snapshots
METADATA_DIR=driftguard-dataset/metadata
SPLITS_DIR=driftguard-dataset/splits
MUTATIONS_DIR=driftguard-dataset/mutations

# Evaluation settings
EVAL_SAMPLE_SIZE=200
EVAL_RANDOM_SEED=42

# ChromaDB
CHROMA_PERSIST_DIR=.chroma_db

# GitHub token (optional, only for PR analysis)
# GITHUB_TOKEN=
